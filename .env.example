# Copy this file to .env and fill in real values.
# cp .env.example .env

# PostgreSQL connection string used by Prisma at runtime (pooled connection
# if your provider supports one, e.g. Neon, Supabase, or a local Postgres
# instance).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Direct (non-pooled) PostgreSQL connection string, used for Prisma
# migrations. Can be the same value as DATABASE_URL for a local database.
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Secret used by Auth.js/NextAuth to sign and encrypt session tokens.
# Generate one with: npx auth secret
AUTH_SECRET="your-auth-secret"

# GitHub OAuth App credentials, used for GitHub login.
# Create one at https://github.com/settings/developers and set the callback
# URL to http://localhost:3000/api/auth/callback/github for local dev.
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"
